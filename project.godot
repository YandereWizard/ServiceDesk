; Engine configuration file.
; Godot 4 — Service Desk demo (desk HUD + baked AI voice + AV scaffolding)
config_version=5

[application]
config/name="Service Desk"
config/description="Workplace comedy helpdesk: take the call, type the name, fix the mess, get graded."
config/version="0.3.0-demo"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"

[audio]
driver/enable_input=true

[autoload]
GameState="*res://scripts/game_state.gd"
UserSettings="*res://scripts/user_settings.gd"
SecondDisplay="*res://scripts/second_display.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/subwindows/embed_subwindows=false

[input]
ui_accept={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194309,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}

[rendering]
renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.07, 0.09, 0.11, 1)
